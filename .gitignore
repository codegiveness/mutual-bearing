# Public distribution allowlist. New files remain local until reviewed.
# Ignoring does not protect files already tracked or added with git add -f.
/*
!/.gitignore
!/AGENTS.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/GUIDANCE.md
!/LICENSE
!/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/checks.yml
!/docs/
/docs/*
!/docs/design.md
!/docs/diagnosis.md
!/docs/integration.md
!/docs/publishing.md
!/scripts/
/scripts/*
!/scripts/sync-guidance.mjs
!/skills/
/skills/*
!/skills/mutual-bearing-setup/
!/skills/mutual-bearing-repair/
/skills/mutual-bearing-setup/*
!/skills/mutual-bearing-setup/SKILL.md
!/skills/mutual-bearing-setup/LICENSE
!/skills/mutual-bearing-setup/assets/
/skills/mutual-bearing-setup/assets/*
!/skills/mutual-bearing-setup/assets/GUIDANCE.md
!/skills/mutual-bearing-setup/scripts/
/skills/mutual-bearing-setup/scripts/*
!/skills/mutual-bearing-setup/scripts/setup.mjs
/skills/mutual-bearing-repair/*
!/skills/mutual-bearing-repair/SKILL.md
!/skills/mutual-bearing-repair/LICENSE
!/evaluation/
/evaluation/*
!/evaluation/README.md
!/evaluation/cases.json
!/evaluation/run.py
!/evaluation/setup.test.mjs
